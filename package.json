{
  "name": "todo-app-ngrx",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:prod": "http-server ./dist/myapp/browser -p 8080",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "pnpm run build && playwright test",
    "e2e:install": "playwright install",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@angular/animations": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-browser-dynamic": "22.1.4",
    "@angular/router": "22.1.4",
    "@ngrx/signals": "^22.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.3.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.23.1",
    "@types/jasmine": "4.0.0",
    "@types/node": "^26.4.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "14.1.1",
    "jasmine-core": "4.1.0",
    "karma": "6.3.0",
    "karma-chrome-launcher": "3.1.0",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.0.0",
    "karma-jasmine-html-reporter": "1.7.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  }
}
